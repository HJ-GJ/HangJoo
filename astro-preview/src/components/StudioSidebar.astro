---
import { getCollection } from 'astro:content';
const rawBase=import.meta.env.BASE_URL;
const base=rawBase.endsWith('/')?rawBase:rawBase+'/';
const route=Astro.url.pathname;
const isWriting=route.endsWith('/writing.html');
const selectedSection=Astro.url.searchParams.get('section');
const posts=await getCollection('blog');
const count=key=>posts.filter(p=>p.data.section===key).length;
const categories=[
  { label:'Study Notes', key:'study', path:'M4 19.5A2.5 2.5 0 0 1 6.5 17H20 M6.5 3H20v18H6.5A2.5 2.5 0 0 1 4 18.5v-13A2.5 2.5 0 0 1 6.5 3Z' },
  { label:'Projects',key:'projects',path:'M3 7h7l2 2h9v11H3z M3 7V5h6l2 2' },
  { label:'Useful Info',key:'info',path:'M9 18h6 M10 21h4 M9 14c-1.4-1.2-2-2.3-2-4a5 5 0 0 1 10 0c0 1.7-.6 2.8-2 4l-1 2h-4z' },
  { label:'Reviews',key:'reviews',path:'M12 3l2.8 5.8 6.2.9-4.5 4.4 1.1 6.2L12 17.4l-5.6 2.9 1.1-6.2L3 9.7l6.2-.9z' }
];
const others=[
  {label:'About',href:base+'#about',path:'M20 21v-2a8 8 0 0 0-16 0v2 M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8'},
  {label:'GitHub',href:'https://github.com/HJ-GJ',path:'M9 19c-4 1-4-2-6-2 M15 22v-3.5a3 3 0 0 0-1-2.3c3-.3 6-1.4 6-7A5.6 5.6 0 0 0 18.5 5 5.2 5.2 0 0 0 18.4 1S17 1.3 14 3a14 14 0 0 0-4 0C7 1.3 5.6 1 5.6 1A5.2 5.2 0 0 0 5.5 5 5.6 5.6 0 0 0 4 9.2c0 5.6 3 6.7 6 7a3 3 0 0 0-1 2.3V22'},
  {label:'Search',href:base+'writing.html#archive-search',path:'m21 21-4.5-4.5 M19 11a8 8 0 1 1-16 0 8 8 0 0 1 16 0'}
];
---
<aside class="studio-sidebar" aria-label="Blog navigation">
  <details class="studio-menu" open>
    <summary class="studio-menu-toggle" aria-label="Open or close navigation menu">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      <span>Menu</span><span class="studio-menu-chevron" aria-hidden="true">⌄</span>
    </summary>
    <div class="studio-menu-panel">
      <a class="studio-profile" href={base} aria-label="HangJoo's Lab — home">
        <span class="studio-avatar" aria-hidden="true">HJ.</span>
        <strong>HangJoo's Lab</strong>
        <small>Cho Hyeong Joo</small>
      </a>
      <nav class="studio-primary-nav" aria-label="All Posts">
        <a href={base+'writing.html'} aria-current={isWriting&&!selectedSection?'page':undefined}>
          <svg class="studio-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="14" height="14" rx="2"/><path d="M7 3h12a2 2 0 0 1 2 2v12"/></svg>
          <span>All Posts</span>
        </a>
      </nav>
      <section class="studio-navigation-group" aria-label="Categories">
        <h2 class="studio-menu-heading">CATEGORIES</h2>
        <nav class="studio-menu-links" aria-label="Categories">
          {categories.map(item=><a href={base+'writing.html?section='+item.key} aria-current={isWriting&&selectedSection===item.key?'page':undefined}>
            <svg viewBox="0 0 24 24" class="studio-nav-icon" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={item.path}/></svg>
            <span class="studio-nav-label">{item.label}</span>
            <span class="studio-nav-count">{count(item.key)}</span>
          </a>)}
        </nav>
      </section>
      <section class="studio-navigation-group studio-navigation-last" aria-label="Other">
        <h2 class="studio-menu-heading">OTHER</h2>
        <nav class="studio-menu-links" aria-label="Other">
          {others.map(item=><a href={item.href} target={item.label==='GitHub'?'_blank':undefined} rel={item.label==='GitHub'?'noopener noreferrer':undefined}>
            <svg viewBox="0 0 24 24" class="studio-nav-icon" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={item.path}/></svg>
            <span class="studio-nav-label">{item.label}</span>
          </a>)}
        </nav>
      </section>
      <div class="studio-visitor" title="A verified visitor analytics source has not been connected">
        <span>Visitors</span><span aria-label="Visitor statistics are not connected">—</span>
      </div>
    </div>
  </details>
</aside>
<script is:inline>
  const menu=document.querySelector('.studio-menu');
  if(menu){
    const mobile=window.matchMedia('(max-width: 880px)');
    const set=()=>{menu.open=!mobile.matches};
    set();
    mobile.addEventListener('change',set);
  }
</script>
