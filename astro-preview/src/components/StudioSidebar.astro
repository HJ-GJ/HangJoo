---
import { getCollection } from 'astro:content';
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
const route = Astro.url.pathname;
const isHome = route === base || route === base.slice(0,-1);
const isWriting = route.endsWith('/writing.html');
const selectedSection = Astro.url.searchParams.get('section');
const posts = await getCollection('blog');
const countSection = section => posts.filter(post => post.data.section === section).length;
const quickLinks = [
  {label:'홈',href:base,icon:'M3 10 12 3l9 7v10H3z M9 20v-7h6v7',current:isHome},
  {label:'Recent · 최신 글',href:base+'#recent',icon:'M4 12a8 8 0 1 0 2-5 M4 4v8h8'},
  {label:'전체 글',href:base+'writing.html',icon:'M6 3h12l3 4v14H6z M10 11h7 M10 15h7',current:isWriting&&!selectedSection}
];
const categories = [
  {label:'공부 기록',key:'study',icon:'M4 5a2 2 0 0 1 2-2h14v17H6a2 2 0 0 1-2-2z M4 18a2 2 0 0 1 2-2h14'},
  {label:'프로젝트',key:'projects',icon:'M3 7h7l2 2h9v11H3z'},
  {label:'유용한 정보',key:'info',icon:'M9 18h6 M9 21h6 M8 14a6 6 0 1 1 8 0l-2 3h-4z'},
  {label:'리뷰',key:'reviews',icon:'M12 2l3 6 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1z'}
];
---
<aside class="studio-sidebar" aria-label="블로그 전체 메뉴">
  <details class="studio-menu" open>
    <summary class="studio-menu-toggle" aria-label="블로그 메뉴 펼치기 또는 접기">
      <span class="studio-menu-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </span>
      <span>메뉴</span>
      <span class="studio-menu-chevron" aria-hidden="true">⌄</span>
    </summary>
    <div class="studio-menu-panel">
      <a class="studio-profile" href={base} aria-label="HangJoo's Lab 홈">
        <span class="studio-avatar" aria-hidden="true">HJ.</span>
        <span class="studio-profile-copy">
          <strong>HangJoo’s Lab.</strong>
          <small>Cho Hyeong Joo</small>
        </span>
      </a>

      <section class="studio-navigation-group">
        <p class="studio-menu-heading">바로가기</p>
        <nav class="studio-menu-links" aria-label="주요 페이지">
          {quickLinks.map(item =>
            <a href={item.href} aria-current={item.current ? 'page' : undefined}>
              <svg viewBox="0 0 24 24" class="studio-nav-icon" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={item.icon}/></svg>
              <span class="studio-nav-label">{item.label}</span>
            </a>
          )}
        </nav>
      </section>

      <section class="studio-navigation-group">
        <p class="studio-menu-heading">카테고리</p>
        <nav class="studio-menu-links" aria-label="콘텐츠 카테고리">
          {categories.map(item =>
            <a href={base+'writing.html?section='+item.key} aria-current={isWriting&&selectedSection===item.key ? 'page' : undefined}>
              <svg viewBox="0 0 24 24" class="studio-nav-icon" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={item.icon}/></svg>
              <span class="studio-nav-label">{item.label}</span>
              <span class="studio-nav-count">{countSection(item.key)}</span>
            </a>
          )}
        </nav>
      </section>

      <section class="studio-navigation-group studio-navigation-last">
        <p class="studio-menu-heading">기타</p>
        <nav class="studio-menu-links" aria-label="기타">
          <a href={base+'#about'}>
            <svg viewBox="0 0 24 24" class="studio-nav-icon" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg>
            <span class="studio-nav-label">소개</span>
          </a>
        </nav>
      </section>
    </div>
  </details>
</aside>
<script is:inline>
  const studioMenu = document.querySelector('.studio-menu');
  if (studioMenu) {
    const narrow = window.matchMedia('(max-width: 1160px)');
    studioMenu.open = !narrow.matches;
    narrow.addEventListener('change', event => { studioMenu.open = !event.matches; });
  }
</script>
