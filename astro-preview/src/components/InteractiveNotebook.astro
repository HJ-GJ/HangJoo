<div class="hj-book-scene" aria-label="HJ 인터랙티브 노트">
  <div class="hj-book-backdrop" aria-hidden="true"></div>
  <div class="hj-book-orbit" aria-hidden="true"></div>
  <div class="hj-book" data-open="false">
    <div class="hj-book-pages" id="hj-book-pages" inert aria-hidden="true">
      <button class="hj-book-close" type="button" aria-label="노트 닫기">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"/></svg>
      </button>
      <span class="hj-book-overline">A PAGE OF NOTES</span>
      <h2>Cho Hyeong Joo</h2>
      <p class="hj-book-lead">배우고, 다시 공부하며, 내 것으로 만드는 기록.</p>
      <div class="hj-book-rule" aria-hidden="true"></div>
      <p class="hj-book-description">수업에서 배운 내용을 다시 찾아보고, AI에게 질문하며 제 말로 정리하고 있어요.</p>
      <a class="hj-book-about" href="#about">소개글 보기 <span aria-hidden="true">↗</span></a>
    </div>
    <button class="hj-book-cover" type="button" aria-expanded="false" aria-controls="hj-book-pages" aria-label="HJ 노트 열기">
      <span class="hj-book-cover-top" aria-hidden="true">
        <svg class="notebook-cover-symbol" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 3v18M12 8h4M12 12h4"/></svg>
      </span>
      <span class="hj-book-mark" aria-hidden="true">HJ<span>.</span></span>
    </button>
  </div>
</div>
<script is:inline>
  (() => {
    const scene = document.querySelector('.hj-book-scene');
    const book = scene?.querySelector('.hj-book');
    const cover = scene?.querySelector('.hj-book-cover');
    const pages = scene?.querySelector('.hj-book-pages');
    const close = scene?.querySelector('.hj-book-close');
    if (!scene || !book || !cover || !pages || !close) return;
    const setOpen = (open) => {
      book.classList.toggle('is-open', open);
      book.dataset.open = String(open);
      cover.setAttribute('aria-expanded', String(open));
      cover.setAttribute('aria-label', open ? 'HJ 노트 펼침' : 'HJ 노트 열기');
      pages.setAttribute('aria-hidden', String(!open));
      pages.inert = !open;
      if (open) close.focus({ preventScroll: true });
      else cover.focus({ preventScroll: true });
    };
    cover.addEventListener('click', () => setOpen(true));
    close.addEventListener('click', () => setOpen(false));
    scene.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && book.classList.contains('is-open')) {
        e.preventDefault();
        setOpen(false);
      }
    });
    // Keep the actual pages inert before first interaction, even in older browsers.
    setOpen(false);
    if (document.activeElement === cover) cover.blur();
  })();
</script>
