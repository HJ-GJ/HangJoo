<div class="hj-book-scene" aria-label="HJ 인터랙티브 노트">
  <div class="hj-book-backdrop" aria-hidden="true"></div>
  <div class="hj-book-orbit" aria-hidden="true"></div>
  <span class="hj-book-sticker hj-book-sticker--a" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 2v20M2 12h20M5 5l14 14M19 5 5 19"/></svg>
    LITTLE DISCOVERIES
  </span>
  <span class="hj-book-sticker hj-book-sticker--b" aria-hidden="true"># KEEP LEARNING</span>
  <div class="hj-book" data-open="false">
    <div class="hj-book-pages" id="hj-book-pages" inert aria-hidden="true">
      <span class="hj-book-overline">A PAGE OF NOTES</span>
      <div class="hj-book-rule" aria-hidden="true"></div>
      <ul class="hj-book-checklist" aria-label="배움의 기록">
        <li>새로 이해한 개념</li>
        <li>직접 확인한 코드</li>
        <li>다음에 알아볼 내용</li>
      </ul>
      <div class="hj-book-rule hj-book-rule--bottom" aria-hidden="true"></div>
      <p class="hj-book-volume">HangJoo's Lab / Vol. 01</p>
      <button class="hj-book-close" type="button" aria-label="속지를 눌러 HJ 노트 닫기"></button>
    </div>
    <button class="hj-book-cover" type="button" aria-expanded="false" aria-controls="hj-book-pages" aria-label="HJ 노트 열기">
      <span class="hj-book-cover-front" aria-hidden="true">
        <span class="hj-book-cover-top">
          <span>HJ / PERSONAL ARCHIVE</span>
          <svg class="notebook-cover-symbol" viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 2v20M2 12h20M5 5l14 14M19 5 5 19"/></svg>
        </span>
        <span class="hj-book-mark">HJ<span>.</span></span>
        <span class="hj-book-cover-foot"><strong>THE NOTEBOOK</strong><small>VOL. 01</small></span>
      </span>
      <span class="hj-book-cover-back" aria-hidden="true"></span>
    </button>
  </div>
  <span class="hj-book-caption" aria-live="polite">노트를 눌러 펼쳐보세요</span>
</div>
<script is:inline>
  (() => {
    const scene = document.querySelector('.hj-book-scene');
    const book = scene?.querySelector('.hj-book');
    const cover = scene?.querySelector('.hj-book-cover');
    const pages = scene?.querySelector('.hj-book-pages');
    const close = scene?.querySelector('.hj-book-close');
    const caption = scene?.querySelector('.hj-book-caption');
    if (!scene || !book || !cover || !pages || !close || !caption) return;
    const setOpen = (open, focus = true) => {
      if (focus) book.classList.add('has-interacted');
      book.classList.toggle('is-open', open);
      book.dataset.open = String(open);
      cover.setAttribute('aria-expanded', String(open));
      cover.setAttribute('aria-label', open ? 'HJ 노트 펼침' : 'HJ 노트 열기');
      pages.setAttribute('aria-hidden', String(!open));
      pages.inert = !open;
      cover.inert = open; // A fully opened, visually absent cover must not be keyboard-focusable.
      caption.textContent = open ? '다시 누르면 노트를 덮습니다' : '노트를 눌러 펼쳐보세요';
      if (focus) (open ? close : cover).focus({ preventScroll: true });
    };
    cover.addEventListener('click', () => setOpen(true));
    close.addEventListener('click', () => setOpen(false));
    scene.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && book.classList.contains('is-open')) {
        e.preventDefault();
        setOpen(false);
      }
    });
    setOpen(false, false);
  })();
</script>
