---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const wholeSeries = post.data.seriesKey ? await getCollection('blog') : [];
const chapters = wholeSeries
  .filter(entry => entry.data.seriesKey===post.data.seriesKey && (entry.data.seriesPart??0)>0)
  .sort((a,b)=>(a.data.seriesPart??0)-(b.data.seriesPart??0));
const chapterIndex = chapters.findIndex(entry=>entry.id===post.id);
const previousChapter = chapterIndex>0 ? chapters[chapterIndex-1] : null;
const nextChapter = chapterIndex>=0 && chapterIndex<chapters.length-1 ? chapters[chapterIndex+1] : null;
const originalArticle = wholeSeries.find(entry=>entry.data.seriesKey===post.data.seriesKey && entry.data.archiveOnly);

const toc = headings.filter(h => h.depth === 2).map(h => {
  const match = h.text.match(/^(\d+)\.\s+(개념|실습|확인|정리)\s*·\s*(.+)$/);
  return { ...h, number: match?.[1] ?? '', group: match?.[2] ?? '', label: match?.[3] ?? h.text };
});
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---
<BaseLayout title={post.data.title} description={post.data.summary}>
  <main class="article-wrap" id="main-content">
    <header class="article-heading">
      <a class="back" href={base + 'writing.html'}>← 전체 글로 돌아가기</a>
      <p class="meta" style="margin-top:25px">{post.data.issue} · {post.data.category} · {post.data.date.toLocaleDateString('ko-KR',{timeZone:'UTC'})}</p>
      <h1>{post.data.title}</h1>
      <p class="summary">{post.data.summary}</p>
      <div class="article-labels" aria-label="글의 주제와 구성">
        <div class="tags" aria-label="주제 태그">{post.data.tags.map(t=><span class="tag">#{t}</span>)}</div>
        <div class="article-tools" aria-label="글 유형"><span class="pill">공부 기록</span><span class="pill">코드 · 시각자료 포함</span></div>
      </div>
    </header>
    {chapters.length>0&&<section class="article-series-nav" aria-label="이 글의 시리즈 목차">
      <div class="series-heading">
        <span class="series-eyebrow">{post.data.archiveOnly ? 'ORIGINAL EDITION' : 'LEARNING SERIES'}</span>
        <h2>{post.data.seriesTitle}</h2>
        <p>{post.data.archiveOnly
          ? '이 페이지는 예전에 공개했던 긴 통합 원문입니다. 아래에서 주제별로 나눈 짧은 시리즈를 읽을 수 있어요.'
          : '짧게 나누어 차례로 읽어보세요. 각 편의 코드와 예제는 원문을 보존해 구성했습니다.'}</p>
      </div>
      <ol class="series-chapter-list">
        {chapters.map((part,index)=><li>
          <a href={base+'posts/'+part.id+'.html'} aria-current={part.id===post.id?'page':undefined}>
            <span class="series-chapter-number">{String(index+1).padStart(2,'0')}</span>
            <span class="series-chapter-title">{part.data.title.replace('파이썬 기초 공부: ','')}</span>
            <span class="series-chapter-arrow" aria-hidden="true">↗</span>
          </a>
        </li>)}
      </ol>
      {!post.data.archiveOnly && originalArticle && <a class="series-full-original" href={base+'posts/'+originalArticle.id+'.html'}>원래 통합 원문 보기 ↗</a>}
    </section>}
    <div class="article-grid">
      <article class="prose"><Content /></article>
      <aside class="toc" aria-label="이 글의 목차">
        <details class="toc-details" open>
          <summary>목차</summary>
          <nav aria-label="본문 절 이동">
            {toc.map(h => <a class="toc-entry" href={'#'+h.slug}>
              {h.group && <span class="toc-tag">{h.number}. {h.group}</span>}
              <span class="toc-label">{h.label}</span>
            </a>)}
          </nav>
        </details>
      </aside>
    </div>
    {!post.data.archiveOnly && chapters.length>0&&<nav class="series-bottom-navigation" aria-label="시리즈 이전 편과 다음 편">
      {previousChapter
        ? <a class="series-bottom-link series-prev" href={base+'posts/'+previousChapter.id+'.html'}><span>← 이전 편</span><strong>{previousChapter.data.title.replace('파이썬 기초 공부: ','')}</strong></a>
        : <span class="series-bottom-placeholder">시리즈 첫 편</span>}
      {nextChapter
        ? <a class="series-bottom-link series-next" href={base+'posts/'+nextChapter.id+'.html'}><span>다음 편 →</span><strong>{nextChapter.data.title.replace('파이썬 기초 공부: ','')}</strong></a>
        : <a class="series-bottom-link series-next" href={base+'categories/study.html'}><span>시리즈 완독!</span><strong>다른 공부 기록 보기 ↗</strong></a>}
    </nav>}
  </main>
  <script is:inline>
    const articleToc = document.querySelector('.toc-details');
    if (articleToc && window.matchMedia('(max-width: 900px)').matches) {
      articleToc.open = false;
    }
    const tocLinks = [...document.querySelectorAll('.toc-entry')];
    const sections = tocLinks.map(link => document.getElementById(decodeURIComponent(link.hash.slice(1))));
    const updateActiveSection = () => {
      if (!tocLinks.length) return;
      let active = 0;
      for (let index = 0; index < sections.length; index++) {
        if (sections[index] && sections[index].getBoundingClientRect().top < window.innerHeight * .4) active = index;
      }
      tocLinks.forEach((link,index) => {
        if (index === active) link.setAttribute('aria-current','location');
        else link.removeAttribute('aria-current');
      });
    };
    window.addEventListener('scroll',updateActiveSection,{passive:true});
    updateActiveSection();
    const labFrame=document.querySelector('.study-lab-frame');
    if(labFrame){
      const resizeLab=()=>{
        try{
          const inner=labFrame.contentDocument;
          const height=inner?.documentElement?.scrollHeight;
          if(Number.isFinite(height)&&height>300&&height<2900)labFrame.style.height=Math.ceil(height+8)+'px';
        }catch{}
      };
      labFrame.addEventListener('load',resizeLab);
      window.addEventListener('message',(event)=>{
        if(event.origin!==window.location.origin||event.source!==labFrame.contentWindow||event.data?.type!=='hangjoo-copy-lab-height')return;
        const height=Number(event.data.height);
        if(Number.isFinite(height)&&height>300&&height<2900)labFrame.style.height=Math.ceil(height+8)+'px';
      });
      window.addEventListener('resize',resizeLab,{passive:true});
    }
  </script>
</BaseLayout>
