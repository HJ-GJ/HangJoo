---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter(h => h.depth === 2);
const base = import.meta.env.BASE_URL.replace(/\\/?$/, '/');
---
<BaseLayout title={post.data.title} description={post.data.summary}>
  <main class="article-wrap" id="main-content">
    <header class="article-heading">
      <a class="back" href={base}>← 학습 기록으로 돌아가기</a>
      <p class="meta" style="margin-top:25px">{post.data.issue} · {post.data.category} · {post.data.date.toLocaleDateString('ko-KR',{timeZone:'UTC'})} · {post.data.readTime}</p>
      <h1>{post.data.title}</h1>
      <p class="summary">{post.data.summary}</p>
      <div class="tags">{post.data.tags.map(t=><span class="tag">#{t}</span>)}</div>
      <div class="article-tools"><span class="pill">개념 → 시각자료 → 코드 → 복습</span><span class="pill">이론·실습 중심 학습 글</span></div>
    </header>
    <div class="article-grid">
      <article class="prose"><Content /></article>
      <aside class="toc" aria-label="이 글의 목차"><details open><summary>이 글의 목차 · {toc.length}개 절</summary><nav aria-label="본문 절 이동">{toc.map(h=><a href={'#'+h.slug}>{h.text}</a>)}</nav></details></aside>
    </div>
  </main>
</BaseLayout>
