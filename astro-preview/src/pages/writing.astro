---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
const posts = (await getCollection('blog')).filter(post=>!post.data.archiveOnly).sort((a,b) => b.data.date.getTime()-a.data.date.getTime() || b.data.issue.localeCompare(a.data.issue));
const categories = [...new Set(posts.map(post => post.data.category))];
const countFor = (c) => posts.filter(post => post.data.category === c).length;
const sections = [{key:'study',name:'Study Notes'},{key:'projects',name:'프로젝트'},{key:'info',name:'유용한 정보'},{key:'reviews',name:'리뷰'}];
const countSection = key => posts.filter(post=>post.data.section===key).length;
const formattedDate = (date) => date.toLocaleDateString('ko-KR', {timeZone:'UTC', year:'numeric', month:'2-digit', day:'2-digit'});
---
<BaseLayout title="All Posts" description="HangJoo's Lab의 공개된 공부 기록과 경험을 주제별로 살펴봅니다.">
  <main class="container writing-page" id="main-content">
    <header class="writing-page-header">
      <p class="notebook-kicker">HANGJOO'S LAB / ARCHIVE</p>
      <h1>All Posts</h1>
      <p>배운 내용을 다시 공부하고 찾아보며, 조금씩 제 것으로 만들어 온 기록을 모았습니다.</p>
    </header>
    <form id="archive-search" class="archive-search" action={base+'writing.html'} method="get" role="search">
      <label for="archive-search-input">Search posts</label>
      <div class="archive-search-row">
        <input id="archive-search-input" type="search" name="q" placeholder="Search titles, topics, or tags" />
        <button type="submit">Search</button>
      </div>
    </form>
    <div class="writing-layout">
      <nav class="writing-section-tabs" aria-label="Study Notes, 프로젝트, 유용한 정보, 리뷰 분류">
        <a id="section-all" href={base+'writing.html'}>전체 글 <span>{posts.length}</span></a>
        {sections.map(section => <a data-section-link={section.key} href={base+'writing.html?section='+section.key}>
          {section.name} <span>{countSection(section.key)}</span>
        </a>)}
      </nav>
      <nav class="writing-quick-categories" aria-label="공개된 글 주제별 보기">
        <a id="side-all" href={base+'writing.html'}>전체 {posts.length}</a>
        {categories.map(category => <a data-side-category={category} href={base+'writing.html?category='+encodeURIComponent(category)}>
          {category} <span class="side-count">{countFor(category)}</span>
        </a>)}
      </nav>

      <section class="writing-results" aria-labelledby="results-heading">
        <div class="writing-results-top">
          <div>
            <h2 id="results-heading">Published Notes</h2>
            <p id="writing-search-info" class="writing-search-info">전체 공개 글</p>
          </div>
          <span id="writing-result-count" class="writing-result-count">{posts.length} posts</span>
        </div>
        <div id="writing-entries" class="notebook-entries writing-entries">
          {posts.map((post,index) => <a class={"notebook-entry writing-entry"+(index===0 || posts[index-1].data.seriesKey!==post.data.seriesKey ? " is-series-start" : "")}
            href={base+'posts/'+post.id+'.html'}
            data-series-key={post.data.seriesKey||""}
            data-category={post.data.category}
            data-section={post.data.section}
            data-search={[post.data.title,post.data.summary,post.data.category,post.data.tags.join(' ')].join(' ').toLowerCase()}>
            
            <span class="entry-body">
            {post.data.seriesKey && <span class="series-group-heading" aria-hidden="true">{post.data.seriesTitle}</span>}
              <span class="entry-meta"><span class="entry-issue-badge">{post.data.seriesPart ? '['+post.data.issue.replace(/^NO\.\s*/i,'').replace('-','_')+']' : '['+post.data.issue.replace(/^NO\.\s*/i,'')+']'}</span>
                <time datetime={post.data.date.toISOString().slice(0,10)}>{formattedDate(post.data.date)}</time>
                <span aria-hidden="true">·</span><span>{post.data.category}</span>
              </span>
              <span class="home-entry-title">{post.data.title}</span>
            {post.data.seriesPart && <span class="series-entry-meta">{post.data.seriesTitle} · {post.data.seriesPart}/{post.data.seriesTotal}편</span>}
              <span class="entry-description">{post.data.summary}</span>
              <span class="entry-tags">{post.data.tags.slice(0,3).map(tag => <span>#{tag}</span>)}</span>
            </span>
            <span class="entry-arrow" aria-hidden="true">↗</span>
          </a>)}
        </div>
        <div id="writing-no-results" class="writing-no-results" hidden>
          <p>검색 결과가 없습니다.</p>
          <a href={base+'writing.html'}>전체 글 보기</a>
        </div>
      </section>
    </div>
  </main>
  <script is:inline>
    const url = new URL(window.location.href);
    const term = (url.searchParams.get('q') || '').trim().toLowerCase();
    const searchInput=document.querySelector('#archive-search-input');
    if(searchInput)searchInput.value=url.searchParams.get('q')||'';
    const category = url.searchParams.get('category') || '';
    const selectedSection = url.searchParams.get('section') || '';
    const sectionNames = {study:'Study Notes',projects:'프로젝트',info:'유용한 정보',reviews:'리뷰'};
    const section = Object.prototype.hasOwnProperty.call(sectionNames,selectedSection) ? selectedSection : '';
    const entries = [...document.querySelectorAll('.writing-entry')];
    const resultCount = document.querySelector('#writing-result-count');
    const info = document.querySelector('#writing-search-info');
    const empty = document.querySelector('#writing-no-results');
    let visible = 0;
    for (const entry of entries) {
      const matches = (!section || entry.dataset.section === section) && (!category || entry.dataset.category === category) && (!term || entry.dataset.search.includes(term));
      entry.hidden = !matches;
      if (matches) visible++;
    }
    let previousSeries = null;
    for (const entry of entries) {
      if (entry.hidden) { entry.classList.remove('is-series-start'); continue; }
      const key = entry.dataset.seriesKey || '';
      entry.classList.toggle('is-series-start',previousSeries!==key);
      previousSeries = key;
    }
    resultCount.textContent = visible + ' posts';
    if (term || category || section) {
      info.textContent = [section && '분류: ' + sectionNames[section], category && '주제: ' + category, term && '검색: ' + term].filter(Boolean).join(' · ');
    }
    empty.hidden = visible > 0;
    const emptyMessage = empty.querySelector('p');
    if (emptyMessage && visible === 0) {
      emptyMessage.textContent = section && !term && !category
        ? sectionNames[section] + '에 공개된 글이 아직 없습니다.'
        : '검색 결과가 없습니다.';
    }
    const currentCategory = category
      ? [...document.querySelectorAll('[data-side-category]')].find(link => link.dataset.sideCategory === category)
      : !section ? document.querySelector('#side-all') : null;
    if (currentCategory) currentCategory.setAttribute('aria-current','page');
    const currentSection = section ? document.querySelector('[data-section-link="'+section+'"]') : document.querySelector('#section-all');
    if (currentSection) currentSection.setAttribute('aria-current','page');
  </script>
</BaseLayout>
