---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
const posts = (await getCollection('blog')).sort((a,b) => b.data.date.getTime() - a.data.date.getTime());
const categories = [...new Set(posts.map(p => p.data.category))];
const formattedDate = (date) => date.toLocaleDateString('ko-KR', { timeZone: 'UTC', year: 'numeric', month: '2-digit', day: '2-digit' });
---
<BaseLayout title="HangJoo's Lab" description="새로 배운 것들을 차근차근 모아두는 공간. 공부와 개발, 직접 써보고 알게 된 것들을 기록합니다.">
  <main class="container notebook-home" id="main-content">
    <section class="notebook-hero" aria-labelledby="home-heading">
      <div class="notebook-intro">
        <p class="notebook-eyebrow"><span class="eyebrow-pin" aria-hidden="true"></span> HANGJOO'S PERSONAL NOTEBOOK</p>
        <h1 id="home-heading">
          <span class="notebook-title-line">새로 배운 것들을</span>
          <span class="notebook-title-line notebook-title-accent">차근차근 모아두는 공간</span>
        </h1>
        <p class="notebook-lead">공부하며 알게 된 것, 직접 만들어 본 것, 써보고 느낀 것들을 하나씩 기록합니다.</p>
        <div class="notebook-actions">
          <a class="primary-link" href="#study">기록 둘러보기</a>
          <a class="text-link" href="#projects">만들어 본 것들 <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <aside class="notebook-cover" aria-label="HangJoo 노트 표지">
        <div class="notebook-cover-top">
          <span>HJ / NOTEBOOK</span>
          <span aria-hidden="true" class="notebook-cover-point">✳</span>
        </div>
        <div class="notebook-monogram" aria-hidden="true"><span>HJ</span><span class="notebook-monogram-dot"></span></div>
        <div class="notebook-cover-bottom">
          <span class="notebook-cover-caption">기록하는 공간</span>
          <span class="notebook-cover-note">STUDY / BUILD / FIND</span>
        </div>
      </aside>
    </section>

    <section class="notebook-drawers" aria-labelledby="drawer-heading">
      <div class="notebook-section-top">
        <div>
          <p class="notebook-kicker">INDEX / 01</p>
          <h2 id="drawer-heading">기록의 서랍</h2>
        </div>
        <p class="notebook-section-description">주제별로 모아둔 기록들</p>
      </div>
      <div class="notebook-drawer-grid">
        <a class="notebook-drawer" href="#study">
          <span class="drawer-no">01 / STUDY</span>
          <span class="drawer-title">배운 것들 <span aria-hidden="true">↗</span></span>
          <span class="drawer-detail">수업 노트와 직접 정리한 개념</span>
        </a>
        <a class="notebook-drawer" href="#projects">
          <span class="drawer-no">02 / PROJECTS</span>
          <span class="drawer-title">만든 것들 <span aria-hidden="true">↗</span></span>
          <span class="drawer-detail">아이디어부터 구현과 시행착오까지</span>
        </a>
        <a class="notebook-drawer" href="#reviews">
          <span class="drawer-no">03 / REVIEWS</span>
          <span class="drawer-title">써본 것들 <span aria-hidden="true">↗</span></span>
          <span class="drawer-detail">게임과 도구, 흥미로운 발견</span>
        </a>
      </div>
    </section>

    <section class="notebook-journal" id="study" aria-labelledby="journal-heading">
      <div class="notebook-section-top notebook-journal-heading">
        <div>
          <p class="notebook-kicker">JOURNAL / 02</p>
          <h2 id="journal-heading">최근에 남긴 기록</h2>
        </div>
        <span class="notebook-count">공개된 글 {posts.length}편</span>
      </div>
      <div class="notebook-filter" aria-label="글 검색과 카테고리">
        <div class="notebook-chips">
          <button type="button" class="chip" aria-pressed="true" data-filter="All">전체</button>
          {categories.map(c => <button type="button" class="chip" aria-pressed="false" data-filter={c}>{c}</button>)}
        </div>
        <input class="search" type="search" id="search" aria-label="게시글 검색" placeholder="제목이나 태그 검색" />
      </div>
      <div class="notebook-entries" id="cards">
        {posts.map((post, index) => <a
          class="notebook-entry"
          href={base + 'posts/' + post.id + '.html'}
          data-category={post.data.category}
          data-search={[post.data.title, post.data.summary, post.data.tags.join(' ')].join(' ').toLowerCase()}
        >
          <div class="entry-index">{String(index + 1).padStart(2, '0')}</div>
          <div class="entry-body">
            <div class="entry-meta"><time datetime={post.data.date.toISOString().slice(0,10)}>{formattedDate(post.data.date)}</time><span aria-hidden="true">·</span><span>{post.data.category}</span><span aria-hidden="true">·</span><span>{post.data.readTime}</span></div>
            <h3>{post.data.title}</h3>
            <p>{post.data.summary}</p>
            <div class="entry-tags">{post.data.tags.slice(0,3).map(t=><span>#{t}</span>)}</div>
          </div>
          <span class="entry-arrow" aria-hidden="true">↗</span>
        </a>)}
      </div>
      <p id="empty" hidden>검색 결과가 없습니다. 다른 키워드로 찾아보세요.</p>
    </section>

    <section class="notebook-bottom" aria-label="다른 기록 공간">
      <div class="notebook-bottom-heading">
        <p class="notebook-kicker">MORE / 03</p>
        <h2>이곳저곳</h2>
        <p>관심사가 늘어나면 서랍도 하나씩 늘어납니다.</p>
      </div>
      <div class="notebook-bottom-list">
        <article id="projects" class="notebook-bottom-item">
          <span class="bottom-item-label">PROJECTS</span>
          <h3>프로젝트 기록</h3>
          <p>직접 만든 프로그램의 설계와 개발 과정을 정리하는 자리입니다. 공개 글은 검토 후 추가합니다.</p>
        </article>
        <article id="reviews" class="notebook-bottom-item">
          <span class="bottom-item-label">REVIEWS & FINDS</span>
          <h3>써보고 발견한 것들</h3>
          <p>게임과 프로그램 사용 후기, 흥미로운 자료를 모을 예정입니다. 아직 공개된 글은 없습니다.</p>
        </article>
        <article id="library" class="notebook-bottom-item">
          <span class="bottom-item-label">LIBRARY</span>
          <h3>참고 자료</h3>
          <p>읽고 도움이 된 자료를 출처와 함께 정리할 예정입니다. 확인된 자료부터 공개합니다.</p>
        </article>
      </div>
    </section>

    <section class="notebook-about" id="about" aria-labelledby="about-heading">
      <p class="notebook-kicker">ABOUT / 04</p>
      <h2 id="about-heading">HangJoo's Lab</h2>
      <p>새로 배운 것들을 쌓아두는 개인 기록 공간입니다. 공부 노트와 프로젝트, 사용 후기 등 여러 관심사를 다룹니다.</p>
    </section>
  </main>
  <script is:inline>
    const chips = [...document.querySelectorAll('.notebook-chips .chip')];
    const search = document.querySelector('#search');
    const entries = [...document.querySelectorAll('.notebook-entry')];
    const empty = document.querySelector('#empty');
    let category = 'All';
    function filter() {
      const query = search.value.trim().toLowerCase();
      let shown = 0;
      for (const entry of entries) {
        const categoryMatch = category === 'All' || entry.dataset.category === category;
        const textMatch = !query || entry.dataset.search.includes(query);
        entry.hidden = !(categoryMatch && textMatch);
        if (!entry.hidden) shown++;
      }
      empty.hidden = shown > 0;
    }
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        category = chip.dataset.filter;
        for (const option of chips) option.setAttribute('aria-pressed', String(option === chip));
        filter();
      });
    }
    search.addEventListener('input', filter);
  </script>
</BaseLayout>
