---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
const posts = (await getCollection('blog')).sort((a,b) => b.data.date.getTime()-a.data.date.getTime());
const recent = posts.slice(0,6);
const countSection = section => posts.filter(post => post.data.section === section).length;
const formattedDate = (date) => date.toLocaleDateString('ko-KR', {timeZone:'UTC', year:'numeric', month:'2-digit', day:'2-digit'});
---
<BaseLayout title="Home" description="새로 배운 것들을 차근차근 모아두는 공간">
  <main class="container notebook-home" id="main-content">
    <section class="notebook-hero" aria-labelledby="home-heading">
      <div class="notebook-intro">
        <p class="notebook-eyebrow"><span class="eyebrow-pin" aria-hidden="true"></span> HANGJOO'S PERSONAL NOTEBOOK</p>
        <h1 id="home-heading">
          <span class="notebook-title-line">새로 배운 것들을</span>
          <span class="notebook-title-line notebook-title-accent">차근차근 모아두는 공간</span>
        </h1>
        <p class="notebook-lead">배운 것을 다시 찾아보고, 질문하며, 조금씩 내 것으로 만들어 가는 기록입니다.</p>
      </div>

      <details class="notebook-cover notebook-interactive">
        <summary aria-label="HJ 노트를 펼쳐 소개 보기">
          <span class="notebook-cover-top" aria-hidden="true">
            <svg class="notebook-cover-symbol" viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="#168574" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <rect x="5" y="3" width="14" height="18" rx="2"/>
              <path d="M9 3v18M12 8h4M12 12h4"/>
            </svg>
          </span>
          <span class="notebook-monogram" aria-hidden="true">HJ<span class="notebook-monogram-dot"></span></span>
 
        </summary>
        <div class="notebook-inside">
          <button class="notebook-inside-close" type="button" aria-label="노트 닫기"><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 5 19 19M19 5 5 19"/></svg></button>
          <div class="notebook-inside-profile">
            <span class="notebook-inside-overline">ABOUT</span>
            <strong class="notebook-inside-name">Cho Hyeong Joo</strong>
            <p class="notebook-inside-bio">배우고, 다시 공부하며, 내 것으로 만드는 기록.</p>
          </div>
          <p class="notebook-inside-about">수업에서 배운 내용을 다시 찾아보고, 궁금한 부분은 AI에게 질문하며 제 말로 정리하고 있어요.</p>
          <a class="notebook-about-link" href="#about">소개글 보기 <span aria-hidden="true">↗</span></a>
        </div>
      </details>
    </section>

    <section class="home-explore home-categories" aria-labelledby="explore-title">
      <div class="notebook-section-top">
        <div><p class="notebook-kicker">EXPLORE THE ARCHIVE</p><h2 id="explore-title">어떤 기록을 볼까요?</h2></div>
      </div>
      <div class="home-explore-grid">
        <a id="study" class="home-explore-item home-category-link" href={base+'writing.html?section=study'}>
          <span class="home-explore-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v17H6.5A2.5 2.5 0 0 1 4 17.5z"/><path d="M4 17.5A2.5 2.5 0 0 1 6.5 15H20"/></svg></span>
          <h3>공부 기록</h3><p>다시 공부하고 이해한 것을 내 말로 정리한 학습 노트</p>
          <span class="home-category-footer">공개 글 {countSection('study')}편 <span aria-hidden="true">↗</span></span>
        </a>
        <a id="projects" class="home-explore-item home-category-link" href={base+'writing.html?section=projects'}>
          <span class="home-explore-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="14" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></span>
          <h3>프로젝트</h3><p>직접 만든 것과 개발 기록</p>
          <span class="home-category-footer">공개 글 {countSection('projects')}편 <span aria-hidden="true">↗</span></span>
        </a>
        <a id="info" class="home-explore-item home-category-link" href={base+'writing.html?section=info'}>
          <span id="library" class="home-legacy-anchor" aria-hidden="true"></span>
          <span class="home-explore-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h11"/><path d="m16 18 2 2 4-5"/></svg></span>
          <h3>유용한 정보</h3><p>찾아보고 정리한 참고 자료와 링크 모음</p>
          <span class="home-category-footer">공개 글 {countSection('info')}편 <span aria-hidden="true">↗</span></span>
        </a>
        <a id="reviews" class="home-explore-item home-category-link" href={base+'writing.html?section=reviews'}>
          <span class="home-explore-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 4h10l4 7-9 10L3 11z"/><path d="M3 11h18M9 4l-2 7 5 10 5-10-2-7"/></svg></span>
          <h3>리뷰</h3><p>게임과 도구 사용 기록</p>
          <span class="home-category-footer">공개 글 {countSection('reviews')}편 <span aria-hidden="true">↗</span></span>
        </a>
      </div>
    </section>

    <section id="recent" class="notebook-journal home-recent" aria-labelledby="recent-heading">
      <div class="notebook-section-top notebook-journal-heading">
        <div><p class="notebook-kicker">RECENT</p><h2 id="recent-heading">최신 글</h2></div>
        <a href={base + 'writing.html'} class="text-link">전체 글 보기 <span aria-hidden="true">↗</span></a>
      </div>
      <div class="notebook-entries">
        {recent.map((post,index) => <a class="notebook-entry" href={base+'posts/'+post.id+'.html'}>
          <span class="entry-index">{String(index+1).padStart(2,'0')}</span>
          <span class="entry-body">
            <span class="entry-meta"><time datetime={post.data.date.toISOString().slice(0,10)}>{formattedDate(post.data.date)}</time><span aria-hidden="true">·</span><span>{post.data.category}</span></span>
            <span class="home-entry-title">{post.data.title}</span>
            <span class="entry-description">{post.data.summary}</span>
          </span>
          <span class="entry-arrow" aria-hidden="true">↗</span>
        </a>)}
        {recent.length===0 && <p class="home-empty">공개된 글이 등록되면 이곳에 나타납니다.</p>}
      </div>
    </section>



    <section id="about" class="notebook-about">
      <p class="notebook-kicker">ABOUT</p><h2>HangJoo's Lab</h2>
      <p>안녕하세요, Cho Hyeong Joo입니다. 수업에서 새롭게 배운 내용을 그대로 지나치지 않고, 혼자 다시 공부하고 자료를 찾아보며 하나씩 이해해 나가고 있습니다. 어렵거나 헷갈리는 부분은 AI에게 다시 질문하면서 제 말로 설명할 수 있을 때까지 살펴보려고 합니다.</p>
      <p>이 블로그에는 그렇게 배우고 확인한 과정을 차근차근 남깁니다. 처음 읽는 분도 함께 따라올 수 있도록 개념이 필요한 이유부터 코드와 예상 출력, 실수하기 쉬운 부분까지 풀어 쓰고, 더 알아본 내용은 공부 기록으로 나누고 싶습니다.</p>
    </section>
  </main>
  <script is:inline>
  const cover = document.querySelector(".notebook-interactive");
  const close = document.querySelector(".notebook-inside-close");
  if (cover && close) close.addEventListener("click", () => { cover.open = false; cover.querySelector("summary")?.focus(); });
</script>
</BaseLayout>
