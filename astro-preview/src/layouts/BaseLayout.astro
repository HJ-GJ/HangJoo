---
import '../styles/global.css';
import '../styles/notebook.css';
import '../styles/site-shell.css';
import '../styles/studio-v3-8.css';
import '../styles/book-concept.css';
import '../styles/sidebar-clean.css';
import '../styles/final-compact.css';
import StudioSidebar from '../components/StudioSidebar.astro';
const { title, description = '새로 배운 것들을 차근차근 모아두는 공간' } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
const isHome = Astro.url.pathname === base || Astro.url.pathname === base.slice(0,-1);
const isWriting = Astro.url.pathname.endsWith('/writing.html');
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title} · HangJoo's Lab</title>
</head>
<body>
  <a href="#main-content" class="skip-link">본문으로 바로가기</a>
  <div class="studio-app">
    <StudioSidebar />
    <div class="studio-page">

  <slot />
  <footer class="container footer">© 2026 HangJoo’s Lab · Personal Notebook · <a href="https://github.com/HJ-GJ">GitHub</a></footer>
    </div>
  </div>

<script is:inline>
  (() => {
    const app = document.querySelector('.studio-app');
    const sidebar = document.querySelector('.studio-sidebar');
    const articleGrid = document.querySelector('.article-grid');
    if (!app || !sidebar || !articleGrid) return;
    const alignArticleRails = () => {
      if (window.innerWidth <= 900) {
        app.style.removeProperty('--article-sidebar-start');
        return;
      }
      // Use the grid's normal-flow position, never the sticky TOC's viewport
      // position; this also works when a deep link restores a scrolled page.
      const distance = articleGrid.getBoundingClientRect().top - app.getBoundingClientRect().top;
      app.style.setProperty('--article-sidebar-start', Math.max(20, Math.round(distance)) + 'px');
    };
    alignArticleRails();
    window.addEventListener('resize', alignArticleRails, { passive: true });
    if (document.fonts?.ready) document.fonts.ready.then(alignArticleRails);
    const heading = document.querySelector('.article-heading');
    if (heading && 'ResizeObserver' in window) new ResizeObserver(alignArticleRails).observe(heading);
  })();
</script>
</body>
</html>
