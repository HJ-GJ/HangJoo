---
import '../styles/global.css';
import '../styles/notebook.css';
import '../styles/site-shell.css';
import '../styles/studio-v3-8.css';
import StudioSidebar from '../components/StudioSidebar.astro';
const { title, description = '새로 배운 것들을 차근차근 모아두는 공간' } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
const isHome = Astro.url.pathname === base || Astro.url.pathname === base.slice(0,-1);
const isWriting = Astro.url.pathname.endsWith('/writing.html');
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title} · HangJoo's Lab</title>
</head>
<body>
  <a href="#main-content" class="skip-link">본문으로 바로가기</a>
  <div class="studio-app">
    <StudioSidebar />
    <div class="studio-page">
  <header class="site-header">
    <div class="container head-inner">
      <a class="brand" href={base} aria-label="HangJoo's Lab 홈">HangJoo<span class="dot">’s Lab.</span></a>
      <nav class="site-nav" aria-label="빠른 기능">
        <a href={base + 'writing.html'} aria-current={isWriting ? 'page' : undefined}>All Posts</a>
        <a href="https://github.com/HJ-GJ/HangJoo" target="_blank" rel="noopener noreferrer">GitHub</a>
      </nav>
      <details class="header-search">
        <summary aria-label="검색 열기" title="Search">
          <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <circle cx="10.7" cy="10.7" r="6.5"/>
            <path d="m16 16 4.8 4.8"/>
          </svg>
        </summary>
        <form action={base + 'writing.html'} method="get" role="search" class="header-search-panel">
          <label for="global-search">Search Posts</label>
          <div class="header-search-fields">
            <input id="global-search" name="q" type="search" placeholder="제목이나 태그 검색" />
            <button type="submit">Search</button>
          </div>
        </form>
      </details>
    </div>
  </header>
  <slot />
  <footer class="container footer">© 2026 HangJoo’s Lab · Personal Notebook · <a href="https://github.com/HJ-GJ/HangJoo">GitHub</a></footer>
    </div>
  </div>
</body>
</html>
