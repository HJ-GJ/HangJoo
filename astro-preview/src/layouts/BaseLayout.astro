---
import '../styles/global.css';
import '../styles/notebook.css';
import '../styles/site-shell.css';
import '../styles/studio-v3-8.css';
import '../styles/book-concept.css';
import '../styles/sidebar-clean.css';
import '../styles/final-compact.css';
import StudioSidebar from '../components/StudioSidebar.astro';
const { title, description = '새로 배운 것들을 차근차근 모아두는 공간' } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
const isHome = Astro.url.pathname === base || Astro.url.pathname === base.slice(0,-1);
const isWriting = Astro.url.pathname.endsWith('/writing.html');
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title} · HangJoo's Lab</title>
</head>
<body>
  <a href="#main-content" class="skip-link">본문으로 바로가기</a>
  <div class="studio-app">
    <StudioSidebar />
    <div class="studio-page">

  <slot />
  <footer class="container footer">© 2026 HangJoo’s Lab · Personal Notebook · <a href="https://github.com/HJ-GJ">GitHub</a></footer>
    </div>
  </div>

<script is:inline>
  (() => {
    const app = document.querySelector('.studio-app');
    const sidebar = document.querySelector('.studio-sidebar');
    const articleGrid = document.querySelector('.article-grid');
    const homeEyebrow = document.querySelector('.notebook-hero .notebook-eyebrow');
    if (!app || !sidebar || (!articleGrid && !homeEyebrow)) return;
    const alignSidebars = () => {
      if (window.innerWidth <= 900) {
        app.style.removeProperty('--article-sidebar-start');
        app.style.removeProperty('--home-sidebar-start');
        return;
      }
      // Compare normal-flow positions relative to the same app container.
      // Subtracting rect positions also works after a deep-link scroll restore.
      const appTop = app.getBoundingClientRect().top;
      if (articleGrid) {
        const offset = articleGrid.getBoundingClientRect().top - appTop;
        const value = Math.max(20, Math.round(offset)) + 'px';
        if (app.style.getPropertyValue('--article-sidebar-start') !== value)
          app.style.setProperty('--article-sidebar-start', value);
      }
      if (homeEyebrow) {
        // Place the top of the menu just below the small hero eyebrow line.
        const offset = homeEyebrow.getBoundingClientRect().top - appTop + 14;
        const value = Math.max(20, Math.round(offset)) + 'px';
        if (app.style.getPropertyValue('--home-sidebar-start') !== value)
          app.style.setProperty('--home-sidebar-start', value);
      }
    };
    alignSidebars();
    window.addEventListener('resize', alignSidebars, { passive: true });
    if (document.fonts?.ready) document.fonts.ready.then(alignSidebars);
    const observed = articleGrid ? document.querySelector('.article-heading') : document.querySelector('.notebook-hero');
    if (observed && 'ResizeObserver' in window) new ResizeObserver(alignSidebars).observe(observed);
  })();
</script>
</body>
</html>
