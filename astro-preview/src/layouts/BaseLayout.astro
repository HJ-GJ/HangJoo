---
import '../styles/global.css';
import '../styles/notebook.css';
const { title, description = 'HangJoo의 개발 및 학습 기록' } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title} · HangJoo's Lab</title>
</head>
<body>
  <a href="#main-content" class="skip-link">본문으로 바로가기</a>
  <header class="site-header">
    <div class="container head-inner">
      <a class="brand" href={base}>HangJoo<span class="dot">’s Lab.</span></a>
      <nav aria-label="주요 메뉴">
        <a href={base}>Home</a>
        <a href={base + '#study'}>Study Notes</a>
        <a href={base + '#projects'}>Projects</a>
        <a href={base + '#library'}>Library</a>
        <a href={base + '#about'}>About</a>
      </nav>
    </div>
  </header>
  <slot />
  <footer class="container footer">© 2026 HangJoo’s Lab · 개인 기록장 · Astro prototype · <a href="https://github.com/HJ-GJ/HangJoo">GitHub</a></footer>
</body>
</html>
