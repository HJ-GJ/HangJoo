---
import '../styles/global.css';
import '../styles/notebook.css';
import '../styles/site-shell.css';
import '../styles/studio-v3-8.css';
import '../styles/book-concept.css';
import '../styles/sidebar-clean.css';
import '../styles/final-compact.css';
import StudioSidebar from '../components/StudioSidebar.astro';
const { title, description = '새로 배운 것들을 차근차근 모아두는 공간' } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
const isHome = Astro.url.pathname === base || Astro.url.pathname === base.slice(0,-1);
const isWriting = Astro.url.pathname.endsWith('/writing.html');
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title} · HangJoo's Lab</title>
</head>
<body>
  <a href="#main-content" class="skip-link">본문으로 바로가기</a>
  <div class="studio-app">
    <StudioSidebar />
    <div class="studio-page">

  <slot />
  <footer class="container footer">© 2026 HangJoo’s Lab · Personal Notebook · <a href="https://github.com/HJ-GJ">GitHub</a></footer>
    </div>
  </div>

<script is:inline>
  (() => {
    const app = document.querySelector('.studio-app');
    const sidebar = document.querySelector('.studio-sidebar');
    const contentColumn = document.querySelector('.notebook-home, main.writing-page, main.article-wrap, main.category-page, main.about-page');
    if (!app || !sidebar || !contentColumn) return;
    const alignSidebars = () => {
      if (window.innerWidth <= 900) {
        sidebar.style.removeProperty('--sidebar-horizontal-offset');
        return;
      }

      // Center the fixed-width sidebar in the *visible left gutter*, from
      // the viewport edge to the actual article/home/archive text column.
      // Translate visually only: don't move the main grid or resize articles.
      const rail = sidebar.getBoundingClientRect();
      const appLeft = app.getBoundingClientRect().left;
      const contentLeft = contentColumn.getBoundingClientRect().left;
      // Use grid's unshifted starting coordinate, not the painted rail.left.
      // Reading the translated rectangle in ResizeObserver would otherwise
      // reapply the offset and accumulate movement on each callback.
      const naturalLeft = appLeft + parseFloat(getComputedStyle(sidebar).marginLeft);
      const centeredLeft = appLeft + (contentLeft - appLeft - rail.width) / 2;
      const safeLeft = Math.min(centeredLeft, contentLeft - rail.width - 20);
      const nextShift = Math.max(0, Math.round(safeLeft - naturalLeft));
      const value = nextShift + 'px';
      if (sidebar.style.getPropertyValue('--sidebar-horizontal-offset') !== value) {
        sidebar.style.setProperty('--sidebar-horizontal-offset', value);
      }
    };
    alignSidebars();
    window.addEventListener('resize', alignSidebars, { passive: true });
    if (document.fonts?.ready) document.fonts.ready.then(alignSidebars);
    const observed = document.querySelector('.notebook-hero, .article-heading, .writing-page-header, .category-page-header, .about-hero');
    if ('ResizeObserver' in window) {
      const observer = new ResizeObserver(alignSidebars);
      if (observed) observer.observe(observed);
      observer.observe(contentColumn);
    }
  })();
</script>
</body>
</html>
